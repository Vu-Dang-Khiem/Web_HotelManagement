<% const isEdit = service !== null; %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="page-title"><%= isEdit ? 'Sửa dịch vụ' : 'Thêm dịch vụ' %></h1>
  <a href="/admin/dich-vu" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Quay lại</a>
</div>

<form method="post" action="<%= isEdit ? '/admin/dich-vu/' + service.id + '?_method=PUT' : '/admin/dich-vu' %>">
  <div class="card"><div class="card-body">
    <div class="row g-3">
      <div class="col-md-8"><label class="form-label">Tên dịch vụ *</label><input type="text" name="name" class="form-control" required value="<%= isEdit ? service.name : '' %>"></div>
      <div class="col-md-4"><label class="form-label">Icon</label><input type="text" name="icon" class="form-control" value="<%= isEdit ? service.icon : 'fa-solid fa-concierge-bell' %>"></div>
      <div class="col-md-4"><label class="form-label">Giá (₫) *</label><input type="number" name="price" class="form-control" required value="<%= isEdit ? service.price : '' %>"></div>
      <div class="col-md-4"><label class="form-label">Đơn vị</label><input type="text" name="unit" class="form-control" value="<%= isEdit ? service.unit : 'lần' %>"></div>
      <div class="col-md-4"><label class="form-label">Trạng thái</label>
        <select name="status" class="form-select">
          <option value="active" <%= isEdit && service.status==='active'?'selected':'' %>>Hoạt động</option>
          <option value="inactive" <%= isEdit && service.status==='inactive'?'selected':'' %>>Ngừng</option>
        </select>
      </div>
      <div class="col-12"><label class="form-label">Mô tả</label><textarea name="description" class="form-control" rows="2"><%= isEdit ? service.description||'' : '' %></textarea></div>
    </div>
    <button class="btn btn-navy mt-4"><i class="fa-solid fa-floppy-disk me-2"></i>Lưu</button>
  </div></div>
</form>
