<% const isEdit = promotion !== null; %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="page-title"><%= isEdit ? 'Sửa khuyến mãi' : 'Thêm khuyến mãi' %></h1>
  <a href="/admin/khuyen-mai" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Quay lại</a>
</div>

<form method="post" action="<%= isEdit ? '/admin/khuyen-mai/' + promotion.id + '?_method=PUT' : '/admin/khuyen-mai' %>">
  <div class="card"><div class="card-body">
    <div class="row g-3">
      <div class="col-md-4"><label class="form-label">Mã *</label><input type="text" name="code" class="form-control text-uppercase" required value="<%= isEdit ? promotion.code : (formData.code||'') %>"></div>
      <div class="col-md-8"><label class="form-label">Tên chương trình *</label><input type="text" name="name" class="form-control" required value="<%= isEdit ? promotion.name : (formData.name||'') %>"></div>
      <div class="col-md-4"><label class="form-label">Loại giảm</label>
        <select name="discount_type" class="form-select">
          <option value="percent" <%= isEdit && promotion.discount_type==='percent'?'selected':'' %>>Phần trăm (%)</option>
          <option value="amount" <%= isEdit && promotion.discount_type==='amount'?'selected':'' %>>Số tiền (₫)</option>
        </select>
      </div>
      <div class="col-md-4"><label class="form-label">Giá trị giảm * <span id="discount-hint" class="text-gold"></span></label><input type="number" name="discount_value" class="form-control" required value="<%= isEdit ? promotion.discount_value : '' %>"></div>
      <div class="col-md-4"><label class="form-label">Đơn tối thiểu (₫)</label><input type="number" name="min_total" class="form-control" value="<%= isEdit ? promotion.min_total : 0 %>"></div>
      <div class="col-md-4"><label class="form-label">Từ ngày</label><input type="date" name="start_date" class="form-control" value="<%= isEdit ? promotion.start_date||'' : '' %>"></div>
      <div class="col-md-4"><label class="form-label">Đến ngày</label><input type="date" name="end_date" class="form-control" value="<%= isEdit ? promotion.end_date||'' : '' %>"></div>
      <div class="col-md-4"><label class="form-label">Trạng thái</label>
        <select name="status" class="form-select">
          <option value="active" <%= isEdit && promotion.status==='active'?'selected':'' %>>Hoạt động</option>
          <option value="inactive" <%= isEdit && promotion.status==='inactive'?'selected':'' %>>Ngừng</option>
        </select>
      </div>
      <div class="col-12"><label class="form-label">Mô tả</label><textarea name="description" class="form-control" rows="2"><%= isEdit ? promotion.description||'' : '' %></textarea></div>
    </div>
    <button class="btn btn-navy mt-4"><i class="fa-solid fa-floppy-disk me-2"></i>Lưu</button>
  </div></div>
</form>
