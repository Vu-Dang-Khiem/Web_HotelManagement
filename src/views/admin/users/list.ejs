<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h1 class="page-title">Người dùng</h1>
  <a href="/admin/nguoi-dung/them" class="btn btn-navy"><i class="fa-solid fa-plus me-2"></i>Thêm người dùng</a>
</div>

<form class="filter-bar mb-3" method="get">
  <div class="row g-2">
    <div class="col-md-4"><input type="text" name="search" value="<%= query.search || '' %>" class="form-control" placeholder="Tên, email, SĐT..."></div>
    <div class="col-md-3">
      <select name="role" class="form-select">
        <option value="">Tất cả vai trò</option>
        <% roles.forEach((r) => { %><option value="<%= r.name %>" <%= query.role===r.name?'selected':'' %>><%= ROLES.LABELS[r.name] %></option><% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <select name="status" class="form-select">
        <option value="">Trạng thái</option>
        <option value="active" <%= query.status==='active'?'selected':'' %>>Hoạt động</option>
        <option value="locked" <%= query.status==='locked'?'selected':'' %>>Bị khóa</option>
      </select>
    </div>
    <div class="col-md-3"><button class="btn btn-navy w-100">Lọc</button></div>
  </div>
</form>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead><tr><th>Người dùng</th><th>Liên hệ</th><th>Vai trò</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
      <tbody>
        <% users.forEach((u) => { %>
          <tr>
            <td><div class="d-flex align-items-center gap-2"><span class="avatar-sm"><%= u.full_name.charAt(0) %></span><div><strong><%= u.full_name %></strong><div class="small text-muted"><%= u.email %></div></div></div></td>
            <td class="small"><%= u.phone || '—' %><br><span class="text-muted"><%= u.address || '' %></span></td>
            <td><span class="badge bg-<%= u.role_name==='admin'?'dark':(u.role_name==='staff'?'info':'secondary') %>"><%= ROLES.LABELS[u.role_name] %></span></td>
            <td><span class="badge bg-<%= u.status==='active'?'success':'danger' %>"><%= u.status==='active'?'Hoạt động':'Bị khóa' %></span></td>
            <td class="text-end">
              <a href="/admin/nguoi-dung/<%= u.id %>/sua" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
              <form method="post" action="/admin/nguoi-dung/<%= u.id %>/khoa?_method=PUT" class="d-inline">
                <button class="btn btn-sm btn-outline-warning"><i class="fa-solid fa-<%= u.status==='active'?'lock':'lock-open' %>"></i></button>
              </form>
              <form method="post" action="/admin/nguoi-dung/<%= u.id %>?_method=DELETE" class="d-inline" data-confirm="Xóa người dùng này?">
                <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../../partials/pagination') %>
