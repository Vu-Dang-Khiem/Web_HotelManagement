<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Hóa đơn <%= invoice.code %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Be Vietnam Pro', sans-serif; background: #f1f4f9; padding: 20px; }
    .footer-brand { font-family: 'Playfair Display', serif; font-size: 1.7rem; font-weight: 700; }
    .invoice-box { background: #fff; padding: 40px; border-radius: 12px; max-width: 800px; margin: auto; box-shadow: 0 4px 18px rgba(0,0,0,.06); }
    @media print { body { background: #fff; padding: 0; } .invoice-box { box-shadow: none; } .no-print { display: none; } }
  </style>
</head>
<body>
  <div class="text-center mb-3 no-print">
    <button onclick="window.print()" class="btn btn-dark"><i></i>In hóa đơn</button>
    <button onclick="window.close()" class="btn btn-outline-secondary">Đóng</button>
  </div>

  <%- include('../../partials/invoice-body') %>

  <script>window.addEventListener('load', () => setTimeout(() => window.print(), 400));</script>
</body>
</html>
