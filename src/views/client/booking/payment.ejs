<%- include('../../partials/page-header', { breadcrumb: [{ label: 'Thanh toán BIDV' }] }) %>

<section class="section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">

        <!-- Tiêu đề -->
        <div class="text-center mb-4">
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
            style="width:90px;height:90px;font-size:2.5rem;background:#003087;color:#fff">
            <i class="fa-solid fa-building-columns"></i>
          </div>
          <h2>Thanh toán qua BIDV</h2>
          <p class="text-muted">Quét mã QR hoặc chuyển khoản theo thông tin bên dưới</p>
          <div class="d-inline-block bg-cream rounded px-4 py-2">
            Mã đơn: <strong class="text-gold fs-5"><%= booking.code %></strong>
          </div>
        </div>

        <div class="row g-4">
          <!-- QR Code -->
          <div class="col-md-5 text-center">
            <div class="border rounded-10 p-4 h-100 d-flex flex-column align-items-center justify-content-center">
              <p class="fw-semibold mb-3">Quét mã QR bằng app ngân hàng</p>
              <img src="<%= qrUrl %>" alt="QR BIDV" class="img-fluid rounded"
                style="max-width:220px" onerror="this.src='';this.alt='Không tải được QR'">
              <small class="text-muted mt-3">Hỗ trợ tất cả app ngân hàng Việt Nam</small>
            </div>
          </div>

          <!-- Thông tin chuyển khoản -->
          <div class="col-md-7">
            <div class="border rounded-10 p-4 h-100">
              <h5 class="mb-3"><i class="fa-solid fa-circle-info text-gold me-2"></i>Thông tin chuyển khoản</h5>
              <table class="table table-borderless mb-0">
                <tr>
                  <td class="text-muted ps-0" style="width:45%">Ngân hàng</td>
                  <td><strong>BIDV</strong></td>
                </tr>
                <tr>
                  <td class="text-muted ps-0">Số tài khoản</td>
                  <td>
                    <strong id="accountNo"><%= bidv.accountNo %></strong>
                    <button class="btn btn-sm btn-outline-secondary ms-2 py-0" onclick="copyText('<%= bidv.accountNo %>', this)">
                      <i class="fa-regular fa-copy"></i>
                    </button>
                  </td>
                </tr>
                <tr>
                  <td class="text-muted ps-0">Chủ tài khoản</td>
                  <td><strong><%= bidv.accountName %></strong></td>
                </tr>
                <% if (bidv.branch) { %>
                <tr>
                  <td class="text-muted ps-0">Chi nhánh</td>
                  <td><%= bidv.branch %></td>
                </tr>
                <% } %>
                <tr>
                  <td class="text-muted ps-0">Số tiền</td>
                  <td><strong class="text-gold fs-5"><%= formatCurrency(booking.total_amount) %></strong></td>
                </tr>
                <tr>
                  <td class="text-muted ps-0">Nội dung CK</td>
                  <td>
                    <strong id="transferContent">Thanh toan dat phong <%= booking.code %></strong>
                    <button class="btn btn-sm btn-outline-secondary ms-2 py-0" onclick="copyText('Thanh toan dat phong <%= booking.code %>', this)">
                      <i class="fa-regular fa-copy"></i>
                    </button>
                  </td>
                </tr>
              </table>
            </div>
          </div>
        </div>

        <!-- Lưu ý -->
        <div class="alert alert-warning mt-4">
          <i class="fa-solid fa-triangle-exclamation me-2"></i>
          <strong>Lưu ý:</strong> Vui lòng nhập <strong>đúng nội dung chuyển khoản</strong> để chúng tôi xác nhận đơn của bạn nhanh hơn.
          Sau khi chuyển khoản, nhân viên sẽ xác nhận trong vòng <strong>30 phút</strong>.
        </div>

        <!-- Tóm tắt đơn -->
        <div class="border rounded-10 p-4 mt-2">
          <h5 class="mb-3">Tóm tắt đơn đặt phòng</h5>
          <div class="row g-3">
            <div class="col-md-6">
              <p class="mb-1"><strong><%= booking.type_name %></strong></p>
              <p class="text-muted mb-1"><i class="fa-solid fa-calendar me-2 text-gold"></i><%= formatDate(booking.check_in) %> → <%= formatDate(booking.check_out) %> (<%= booking.nights %> đêm)</p>
              <p class="text-muted mb-0"><i class="fa-solid fa-user-group me-2 text-gold"></i><%= booking.adults %> người lớn, <%= booking.children %> trẻ em</p>
            </div>
            <div class="col-md-6">
              <div class="summary-row"><span class="text-muted">Tiền phòng</span><span><%= formatCurrency(booking.room_total) %></span></div>
              <% if (booking.services && booking.services.length) { %>
                <div class="summary-row"><span class="text-muted">Dịch vụ thêm</span><span><%= formatCurrency(booking.services_total) %></span></div>
              <% } %>
              <% if (booking.discount > 0) { %>
                <div class="summary-row text-success"><span>Giảm giá</span><span>- <%= formatCurrency(booking.discount) %></span></div>
              <% } %>
              <hr class="my-2">
              <div class="summary-row summary-total"><span>Tổng cộng</span><span class="text-gold"><%= formatCurrency(booking.total_amount) %></span></div>
            </div>
          </div>
        </div>

        <!-- Nút điều hướng -->
        <div class="text-center mt-4 d-flex gap-3 justify-content-center flex-wrap">
          <a href="/dat-phong/thanh-cong/<%= booking.code %>" class="btn btn-gold btn-lg">
            <i class="fa-solid fa-check me-2"></i>Đã chuyển khoản xong
          </a>
          <% if (currentUser) { %>
            <a href="/tai-khoan/don-dat" class="btn btn-outline-gold">Xem đơn của tôi</a>
          <% } %>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
function copyText(text, btn) {
  navigator.clipboard.writeText(text).then(() => {
    const icon = btn.querySelector('i');
    icon.className = 'fa-solid fa-check text-success';
    setTimeout(() => { icon.className = 'fa-regular fa-copy'; }, 2000);
  });
}
</script>