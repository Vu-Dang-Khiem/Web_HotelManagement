# Cấu hình ứng dụng
APP_NAME=Luxury Hotel
PORT=3000
NODE_ENV=development

# Cấu hình cơ sở dữ liệu MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hotel_management

# Khóa bí mật cho session
SESSION_SECRET=hotel_super_secret_key_change_me

# Cấu hình gửi email (Gmail SMTP) — để trống MAIL_PASS sẽ tắt gửi mail
# MAIL_PASS là "App Password" 16 ký tự của Google, KHÔNG phải mật khẩu Gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=
MAIL_TO=your_email@gmail.com
MAIL_FROM_NAME=Luxury Hotel
